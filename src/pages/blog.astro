---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Field Notes — Rutvik Gulhane | viknik.tech" description="Field notes from production engineering, product decisions, and the systems behind them.">
  <div class="blog-hero" id="blog-hero">
    <canvas class="pixel-field" aria-hidden="true"></canvas>
    <div class="blog-hero__content container">
      <span class="blog-hero__eyebrow">Field notes from real systems</span>
      <h1 class="blog-hero__title">ENGINEERING<br />WITH EMPATHY</h1>
      <p class="blog-hero__subtitle">The difficult parts should live underneath the interface. These are the notes from building them.</p>
      <p class="blog-hero__hint">Move your cursor through the field.</p>
      <p class="blog-hero__credit">Interactive hero inspired by <a href="https://www.sanity.io/engineering" target="_blank" rel="noreferrer">Sanity Engineering</a> · Field notes powered by Sanity.</p>
    </div>
  </div>

  <main>
    <section class="sanity-notes section" data-sanity-posts hidden>
      <div class="container container--narrow">
        <span class="field-note__meta">Published from Sanity</span>
        <div class="sanity-notes__list" data-sanity-post-list></div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const hero = document.querySelector('#blog-hero');
  const canvas = hero?.querySelector('.pixel-field');

  if (hero instanceof HTMLElement && canvas instanceof HTMLCanvasElement) {
    const context = canvas.getContext('2d');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const particles: Array<{ x: number; y: number; life: number; maxLife: number; seed: number }> = [];
    let width = 0;
    let height = 0;
    let lastPointer = 0;
    let activePointer: { x: number; y: number; seed: number } | null = null;

    const resize = () => {
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
      width = hero.clientWidth;
      height = hero.clientHeight;
      canvas.width = Math.max(1, Math.floor(width * pixelRatio));
      canvas.height = Math.max(1, Math.floor(height * pixelRatio));
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    };

    const drawCluster = (x: number, y: number, strength: number, seed: number) => {
      if (!context) return;
      const cell = 9;
      const radius = 50 * strength;
      const columns = Math.ceil(radius / cell);
      context.fillStyle = '#1f1630';

      for (let row = -columns; row <= columns; row += 1) {
        for (let column = -columns; column <= columns; column += 1) {
          const distance = Math.hypot(column, row);
          if (distance > columns) continue;
          const noise = Math.sin((column + seed) * 12.9898 + (row - seed) * 78.233) * 43758.5453;
          const random = noise - Math.floor(noise);
          const opacity = (1 - distance / (columns + 0.4)) * strength;
          if (random > opacity * 0.86) continue;
          context.globalAlpha = Math.min(0.94, opacity + 0.12);
          context.fillRect(Math.round(x / cell + column) * cell, Math.round(y / cell + row) * cell, cell - 1, cell - 1);
        }
      }
      context.globalAlpha = 1;
    };

    const paint = () => {
      if (!context) return;
      const now = performance.now();
      context.clearRect(0, 0, width, height);
      particles.forEach((particle) => {
        particle.life -= 1;
        drawCluster(particle.x, particle.y, particle.life / particle.maxLife, particle.seed + now / 130);
      });
      for (let index = particles.length - 1; index >= 0; index -= 1) {
        if (particles[index].life <= 0) particles.splice(index, 1);
      }
      if (activePointer) drawCluster(activePointer.x, activePointer.y, 1, activePointer.seed + now / 90);
      requestAnimationFrame(paint);
    };

    const addTrail = (event: PointerEvent) => {
      if (reducedMotion) return;
      const bounds = hero.getBoundingClientRect();
      const x = event.clientX - bounds.left;
      const y = event.clientY - bounds.top;
      const now = performance.now();
      activePointer = { x, y, seed: now / 200 };
      if (now - lastPointer > 32) {
        particles.push({ x, y, life: 30, maxLife: 30, seed: now / 200 });
        if (particles.length > 24) particles.shift();
        lastPointer = now;
      }
    };

    hero.addEventListener('pointermove', addTrail);
    hero.addEventListener('pointerleave', () => { activePointer = null; });
    window.addEventListener('resize', resize);
    resize();

    if (reducedMotion) drawCluster(width * 0.56, height * 0.52, 0.72, 4);
    else paint();
  }

  const postsSection = document.querySelector<HTMLElement>('[data-sanity-posts]');
  const postsList = document.querySelector<HTMLElement>('[data-sanity-post-list]');
  const sanityQuery = '*[_type == "post" && defined(slug.current) && defined(publishedAt)] | order(publishedAt desc){title, "slug": slug.current, excerpt, publishedAt, tags}';

  if (postsSection && postsList) {
    const endpoint = `https://mz56et1n.apicdn.sanity.io/v2025-02-19/data/query/production?query=${encodeURIComponent(sanityQuery)}`;
    fetch(endpoint)
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('Sanity request failed')))
      .then(({ result }) => {
        if (!Array.isArray(result) || result.length === 0) return;
        result.forEach((post) => {
          const article = document.createElement('article');
          article.className = 'sanity-note';
          const title = document.createElement('h2');
          title.textContent = post.title || 'Untitled note';
          const excerpt = document.createElement('p');
          excerpt.textContent = post.excerpt || 'Read the field note.';
          const link = document.createElement('a');
          link.className = 'btn btn--outline';
          link.href = `/blog/read?slug=${encodeURIComponent(post.slug)}`;
          link.textContent = 'Read note →';
          article.append(title, excerpt, link);
          postsList.append(article);
        });
        postsSection.hidden = false;
      })
      .catch(() => undefined);
  }
</script>

<style>
  .blog-hero { position: relative; min-height: min(580px, 68svh); display: grid; align-items: end; overflow: hidden; border-bottom: 1px solid var(--bg-cream-darker); background: radial-gradient(circle at 18% 24%, color-mix(in srgb, var(--accent-sky) 12%, var(--bg-cream)), transparent 34%), radial-gradient(circle at 82% 76%, color-mix(in srgb, var(--accent-violet) 10%, var(--bg-cream)), transparent 38%), var(--bg-cream); color: var(--text-primary); }
  .pixel-field { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .blog-hero__content { position: relative; z-index: 1; padding-top: clamp(6rem, 12vw, 9rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .blog-hero__eyebrow, .field-note__meta { display: block; margin-bottom: var(--space-md); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .blog-hero__title { margin-bottom: var(--space-xl); font-family: var(--font-mono); font-size: clamp(3.25rem, 10.5vw, 10rem); font-weight: 900; letter-spacing: -0.09em; line-height: 0.82; text-transform: uppercase; }
  .blog-hero__subtitle { max-width: 760px; margin: 0; font-family: var(--font-display); font-size: clamp(var(--text-xl), 3vw, var(--text-3xl)); line-height: 1.08; }
  .blog-hero__hint { margin: var(--space-lg) 0 0; font-family: var(--font-mono); font-size: var(--text-xs); opacity: 0.7; }
  .blog-hero__credit { margin: var(--space-sm) 0 0; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; }
  .blog-hero__credit a { color: inherit; text-decoration-color: color-mix(in srgb, currentColor 55%, transparent); text-underline-offset: 0.18em; }
  .blog-hero__credit a:hover { color: var(--accent-violet); }
  .sanity-notes__list { display: grid; gap: var(--space-lg); }
  .sanity-note { padding: var(--space-xl); border: 1px solid var(--bg-cream-darker); border-radius: var(--radius-lg); background: var(--bg-cream-dark); }
  .sanity-note h2 { margin-bottom: var(--space-sm); font-size: var(--text-xl); }
  .sanity-note p { margin-bottom: var(--space-lg); color: var(--text-muted); line-height: 1.7; }
  @media (max-width: 767px) {
    .blog-hero { min-height: auto; align-items: start; }
    .blog-hero__content { padding-top: calc(46px + var(--space-lg)); padding-bottom: var(--space-xl); }
    .blog-hero__title { letter-spacing: -0.08em; }
    .blog-hero__hint { display: none; }
    .blog-hero__credit { margin-top: var(--space-md); }
  }

  @media (max-width: 640px) {
    .blog-hero__credit { display: none; }
  }
</style>
