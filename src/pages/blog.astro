---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const posts = [
  {
    title: "Leaving EPFO to Build in Surat: The Origin Story",
    teaser: "Why I gave up government job stability to solve inventory chaos for jeans manufacturers.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-coral)"
  },
  {
    title: "15-Day Architecture: Building for ₹5 Crore in Sales",
    teaser: "How to structure a mobile-first app when failure means ruined trade show orders.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-violet)"
  },
  {
    title: "The Overbooking Problem & Pessimistic Locks in Spring Boot",
    teaser: "Deep dive into SELECT ... FOR UPDATE when two agents hit buy on the last item.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-teal)"
  },
  {
    title: "Surgical Order Edits: Identity-Based Diffing",
    teaser: "Why replacing whole order arrays breaks stock math, and how delta diffing fixes it.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-rose)"
  },
  {
    title: "Taming iPhone HEIC Photos on Mobile Web",
    teaser: "Client-side image processing with createImageBitmap fallback to heic2any.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-sky)"
  },
  {
    title: "Modular Monoliths: Zone 0 to Zone 7 Boundaries",
    teaser: "Structuring Spring Boot 3 applications for high cohesion without microservice pain.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-amber)"
  },
  {
    title: "Automating WhatsApp Receipts with Webhooks",
    teaser: "Replacing paper slips with instant WhatsApp message confirmations.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-indigo)"
  },
  {
    title: "The Hardest Part of SaaS Isn't Code: GTM Retrospective",
    teaser: "What Facebook ads taught me about traditional industry distribution.",
    date: "Jul 2026",
    platform: "LinkedIn",
    url: "https://linkedin.com/in/rutvikgulhane",
    color: "var(--accent-pink)"
  }
];
---

<BaseLayout title="Blog & Essays — Rutvik Gulhane | viknik.tech" description="Articles and posts on system design, real-world engineering bugs, building in public, and GTM lessons.">

  <div class="blog-hero">
    <div class="hero__gradient" aria-hidden="true"></div>
    <div class="blog-hero__content container">
      <h1 class="blog-hero__title fade-in">Writing & Insights</h1>
      <p class="blog-hero__subtitle fade-in">Thoughts on building production software, system architecture, and lessons from the ground up.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid--2 fade-in">
        {posts.map((post, idx) => (
          <a href={post.url} target="_blank" rel="noopener noreferrer" class="blog-card" style={`--card-accent: ${post.color}`}>
            <div class="blog-card__header">
              <span class="chapter-badge" style={`color: ${post.color}; border-color: ${post.color}`}>
                #{String(idx + 1).padStart(2, '0')}
              </span>
              <span class="blog-card__platform">{post.platform} · {post.date}</span>
            </div>
            <h3 class="blog-card__title">{post.title}</h3>
            <p class="blog-card__teaser">{post.teaser}</p>
            <span class="blog-card__link">Read Article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .blog-hero {
    position: relative;
    padding: calc(80px + var(--space-4xl)) 0 var(--space-3xl);
    overflow: hidden;
    text-align: center;
  }

  .blog-hero .hero__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 30%, rgba(20, 184, 166, 0.2), transparent 70%),
      radial-gradient(ellipse 70% 50% at 80% 20%, rgba(245, 158, 11, 0.15), transparent 70%);
    animation: gradientShift 12s ease-in-out infinite alternate;
  }

  .blog-hero__content {
    position: relative;
    z-index: 1;
  }

  .blog-hero__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }

  .blog-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .blog-card {
    background: var(--bg-cream-dark);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    border: 1px solid var(--bg-cream-darker);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--card-accent);
  }

  .blog-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .blog-card__platform {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .blog-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .blog-card__teaser {
    font-size: var(--text-sm);
    color: var(--text-muted);
    flex: 1;
    margin-bottom: var(--space-lg);
  }

  .blog-card__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
