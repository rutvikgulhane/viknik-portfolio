---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
---

<BaseLayout title="ExpoApp — 15-Day Build | viknik.tech" description="Deep dive into ExpoApp: A mobile-first order management system for jeans manufacturers built in 15 days, handling ₹9 Cr (~$1.1M) across two expo seasons.">

  <div class="project-hero">
    <div class="hero__gradient" aria-hidden="true"></div>
    <div class="project-hero__content container">
      <div class="project-hero__badge-wrap">
        <span class="chapter-badge" style="color: var(--accent-coral); border-color: var(--accent-coral);">PROJECT 01</span>
        <span class="project-hero__date">Aug 2025 – Present</span>
      </div>
      <div style="display: flex; justify-content: center; gap: 12px; margin-bottom: var(--space-md);">
        <img src="/stickers/badge_15day_build.svg" alt="15-Day Build" width="90" height="90" style="aspect-ratio: 1/1; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1));" />
        <img src="/stickers/badge_9cr_booked.svg" alt="₹9 Cr Booked" width="90" height="90" style="aspect-ratio: 1/1; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1));" />
      </div>
      <h1 class="project-hero__title fade-in">ExpoApp: The 15-Day Build</h1>
      <p class="project-hero__subtitle fade-in">Mobile-first production order management system for apparel manufacturers at wholesale trade expos.</p>
    </div>
  </div>

  <!-- Key Metrics Banner -->
  <section class="metrics-banner section section--alt">
    <div class="container">
      <div class="stats__grid stagger-children">
        <div class="stats__card glass">
          <span class="stats__value">₹9 Cr+</span>
          <span class="stats__label">Wholesale Bookings (~$1.1M)</span>
        </div>
        <div class="stats__card glass">
          <span class="stats__value">15 Days</span>
          <span class="stats__label">Initial Build Time</span>
        </div>
        <div class="stats__card glass">
          <span class="stats__value">2 Seasons</span>
          <span class="stats__label">Expo Operations</span>
        </div>
        <div class="stats__card glass">
          <span class="stats__value">100%</span>
          <span class="stats__label">Paperless Accuracy</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem & Solution Overview -->
  <section class="section">
    <div class="container container--narrow">
      <div class="fade-in">
        <h2 class="section-heading">The Context & Problem</h2>
        <p class="lead-text">
          Trade expos are high-intensity 3-day events where jeans manufacturers take bulk orders worth crores from hundreds of visiting Retailers linked to that city's distributor.
        </p>
        <p>
          Before ExpoApp, sales reps wrote down hundreds of order items manually on paper slips. At peak hours, two reps would unknowingly sell out the same limited stock to different retailers, leading to post-expo cancellation chaos, angry retailers & distributors, and zero real-time sales reporting for the manufacturer.
        </p>

        <h2 class="section-heading" style="margin-top: var(--space-3xl);">The Solution</h2>
        <p>
          In 15 days, I architected and built ExpoApp — a progressive web app (PWA) tailored for noisy, fast-paced expo environments.
        </p>
        <ul class="feature-list">
          <li><strong>Role-Based Access:</strong> Admin dashboard, Sales Agent interface, and Distributor view.</li>
          <li><strong>Mobile QR Scanning:</strong> Sales staff scan sample tags using their phone camera to instantly pull up product variants and stock levels.</li>
          <li><strong>Real-Time Stock Locks:</strong> Prevents overbooking with DB-level pessimistic locking during checkout.</li>
          <li><strong>Automated WhatsApp Receipts:</strong> Instant PDF/text receipt generated and pushed directly to the distributor's phone upon order placement.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Screenshot Gallery -->
  <section class="section section--alt">
    <div class="container">
      <h2 class="section-heading fade-in" style="text-align: center; margin-bottom: var(--space-2xl);">System Interfaces</h2>
      
      <div class="gallery-grid grid grid--2 fade-in">
        <div class="gallery-item">
          <div class="phone-frame">
            <img src="/media/dashboard.jpg" alt="ExpoApp Admin Dashboard" loading="lazy" />
          </div>
          <p class="gallery-caption">Admin Dashboard: Real-time revenue & order tracking</p>
        </div>

        <div class="gallery-item">
          <div class="phone-frame">
            <img src="/media/Product_catalog.jpg" alt="ExpoApp Product Catalog" loading="lazy" />
          </div>
          <p class="gallery-caption">Product Catalog: Instant stock filter & size variant view</p>
        </div>

        <div class="gallery-item">
          <div class="phone-frame">
            <img src="/media/BI_1.jpg" alt="ExpoApp Inventory Overview" loading="lazy" />
          </div>
          <p class="gallery-caption">Inventory Overview: Top selling designs & total stock valuation</p>
        </div>

        <div class="gallery-item">
          <div class="phone-frame">
            <img src="/media/BI_chart_1.jpg" alt="ExpoApp Analytics Chart" loading="lazy" />
          </div>
          <p class="gallery-caption">Analytics: Real-time revenue trends during live expo days</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack & Architecture -->
  <section class="section">
    <div class="container container--narrow">
      <h2 class="section-heading fade-in">Tech Stack & Architecture</h2>
      <div class="tech-grid fade-in">
        <div class="tech-card">
          <div class="tech-card__badge-wrap">
            <img src="/stickers/tech_react.svg" alt="React" width="48" height="48" style="aspect-ratio: 1/1;" />
            <span class="sticker sticker--coral">Frontend</span>
          </div>
          <h3>React + RTK Query</h3>
          <p>PWA build, mobile-first responsive layout, client-side draft persistence, and offline fallback queue.</p>
        </div>

        <div class="tech-card">
          <div class="tech-card__badge-wrap">
            <img src="/stickers/tech_spring.svg" alt="Spring Boot" width="48" height="48" style="aspect-ratio: 1/1;" />
            <span class="sticker sticker--violet">Backend</span>
          </div>
          <h3>Spring Boot 3 + Java 21</h3>
          <p>RESTful APIs, pessimistic locking for inventory checkout, atomic order editing transactions.</p>
        </div>

        <div class="tech-card">
          <div class="tech-card__badge-wrap">
            <img src="/stickers/tech_postgres.svg" alt="PostgreSQL" width="48" height="48" style="aspect-ratio: 1/1;" />
            <span class="sticker sticker--teal">Database</span>
          </div>
          <h3>PostgreSQL 16</h3>
          <p>UUID primary keys, indexed variant queries, versioned entity checks for optimistic concurrency backup.</p>
        </div>

        <div class="tech-card">
          <div class="tech-card__badge-wrap">
            <img src="/stickers/tech_whatsapp.svg" alt="WhatsApp Webhooks" width="48" height="48" style="aspect-ratio: 1/1;" />
            <span class="sticker sticker--sky">Integrations</span>
          </div>
          <h3>WhatsApp Business API</h3>
          <p>Event-driven webhook notifications for instant order receipts to distributor mobile numbers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Footer -->
  <section class="section section--alt" style="text-align: center;">
    <div class="container container--narrow">
      <h3 style="margin-bottom: var(--space-md);">Explore Next</h3>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="/projects/spotbook" class="btn btn--primary">See SpotBook SaaS →</a>
        <a href="/engineering" class="btn btn--outline">Read Engineering Problems →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .project-hero {
    position: relative;
    padding: calc(80px + var(--space-4xl)) 0 var(--space-3xl);
    overflow: hidden;
    text-align: center;
  }

  .project-hero .hero__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 30%, rgba(249, 115, 22, 0.2), transparent 70%),
      radial-gradient(ellipse 70% 50% at 80% 20%, rgba(236, 72, 153, 0.15), transparent 70%);
    animation: gradientShift 12s ease-in-out infinite alternate;
  }

  .project-hero__content {
    position: relative;
    z-index: 1;
  }

  .project-hero__badge-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .project-hero__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .project-hero__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }

  .project-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-lg);
  }

  .lead-text {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-primary);
    font-weight: 500;
  }

  .feature-list {
    list-style: none;
    margin-top: var(--space-lg);
  }

  .feature-list li {
    position: relative;
    padding-left: var(--space-xl);
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent-coral);
    font-weight: 900;
  }

  /* Gallery Grid */
  .gallery-grid {
    gap: var(--space-2xl);
  }

  .gallery-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .phone-frame {
    width: 100%;
    max-width: 320px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 8px solid #1a1a2e;
    background: #1a1a2e;
  }

  .phone-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery-caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-md);
    text-align: center;
  }

  /* Tech Grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .tech-card {
    background: var(--bg-cream-dark);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--bg-cream-darker);
  }

  .tech-card__badge-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .tech-card h3 {
    font-size: var(--text-lg);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .tech-card p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: 0;
  }
</style>
