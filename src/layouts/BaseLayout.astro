---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Freelance Software Developer & Product Engineer who built a production system in 15 days handling ₹9 Crore across two expo seasons. Spring Boot, React, PostgreSQL." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="viknik.tech" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Fraunces (display), DM Sans (body), JetBrains Mono (mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400&family=JetBrains+Mono:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions for Smooth Page Switching -->
    <ClientRouter />

    <title>{title}</title>
  </head>
  <body>
    <slot name="nav">
      <!-- Desktop & Mobile Header -->
      <nav class="nav" id="main-nav">
        <div class="nav__inner container">
          <a href="/" class="nav__logo" aria-label="Rutvik on a Tech Picnik Home">
            <img src="/stickers/logo_picnik.svg" alt="Rutvik on a Tech Picnik" class="nav__logo-img" height="140" transition:name="nav-logo" />
          </a>

          <!-- Desktop Sticker Nav Links -->
          <ul class="nav__links" role="list">
            <li>
              <a href="/story" class={`nav__item-link ${currentPath === '/story' ? 'is-active' : ''}`}>
                <span class="nav-sticker-icon" style="--icon-accent: var(--accent-coral);">📖</span>
                <span class="nav__item-text">STORY</span>
              </a>
            </li>
            <li>
              <a href="/projects/expoapp" class={`nav__item-link ${currentPath.startsWith('/projects') ? 'is-active' : ''}`}>
                <span class="nav-sticker-icon" style="--icon-accent: var(--accent-violet);">🚀</span>
                <span class="nav__item-text">PROJECTS</span>
              </a>
            </li>
            <li>
              <a href="/engineering" class={`nav__item-link ${currentPath === '/engineering' ? 'is-active' : ''}`}>
                <span class="nav-sticker-icon" style="--icon-accent: var(--accent-amber);">⚡</span>
                <span class="nav__item-text">ENGINEERING</span>
              </a>
            </li>
            <li>
              <a href="/blog" class={`nav__item-link ${currentPath === '/blog' ? 'is-active' : ''}`}>
                <span class="nav-sticker-icon" style="--icon-accent: var(--accent-teal);">✍️</span>
                <span class="nav__item-text">BLOG</span>
              </a>
            </li>
            <li>
              <a href="/contact" class={`nav__item-link ${currentPath === '/contact' ? 'is-active' : ''}`}>
                <span class="nav-sticker-icon" style="--icon-accent: var(--accent-pink);">📬</span>
                <span class="nav__item-text">CONTACT</span>
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Option 3: App-Style Floating Mobile Bottom Dock -->
      <nav class="mobile-bottom-dock" aria-label="Mobile Navigation">
        <a href="/story" class={`mobile-dock-link ${currentPath === '/story' ? 'is-active' : ''}`}>
          <span class="dock-icon" style="--dock-accent: var(--accent-coral);">📖</span>
          <span class="dock-label">STORY</span>
        </a>
        <a href="/projects/expoapp" class={`mobile-dock-link ${currentPath.startsWith('/projects') ? 'is-active' : ''}`}>
          <span class="dock-icon" style="--dock-accent: var(--accent-violet);">🚀</span>
          <span class="dock-label">PROJECTS</span>
        </a>
        <a href="/engineering" class={`mobile-dock-link ${currentPath === '/engineering' ? 'is-active' : ''}`}>
          <span class="dock-icon" style="--dock-accent: var(--accent-amber);">⚡</span>
          <span class="dock-label">ENG</span>
        </a>
        <a href="/blog" class={`mobile-dock-link ${currentPath === '/blog' ? 'is-active' : ''}`}>
          <span class="dock-icon" style="--dock-accent: var(--accent-teal);">✍️</span>
          <span class="dock-label">BLOG</span>
        </a>
        <a href="/contact" class={`mobile-dock-link ${currentPath === '/contact' ? 'is-active' : ''}`}>
          <span class="dock-icon" style="--dock-accent: var(--accent-pink);">📬</span>
          <span class="dock-label">CONTACT</span>
        </a>
      </nav>
    </slot>

    <main transition:animate="fade">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner container">
        <div class="footer__brand">
          <img src="/stickers/logo_picnik.svg" alt="Rutvik on a Tech Picnik" height="120" style="width: auto; max-width: 280px; object-fit: contain; margin: -20px auto -10px;" />
          <p class="footer__tagline">Built by Rutvik. No template. Using <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-coral); text-decoration: none; font-weight: 600;">Astro</a>.</p>
          <img src="/stickers/no_corporate_filter.svg" alt="No Corporate Filter" width="120" height="120" style="aspect-ratio: 1/1; margin: var(--space-md) auto 0; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.08));" />
        </div>
        <div class="footer__links">
          <a href="https://linkedin.com/in/rutvikgulhane" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://github.com/rutvikgulhane" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href="mailto:rutvikgulhanex@gmail.com" class="footer__social" aria-label="Email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>
        <p class="footer__copyright">© {new Date().getFullYear()} Rutvik Gulhane</p>
      </div>
    </footer>

    <!-- Scripts -->
    <script>
      function initPage() {
        // --- Scroll Animations (Intersection Observer) ---
        const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.fade-in, .fade-in-left, .fade-in-right, .stagger-children').forEach((el) => {
          observer.observe(el);
        });

        // --- Smart Scroll Interactions ---
        const nav = document.getElementById('main-nav');
        const bottomDock = document.querySelector('.mobile-bottom-dock');
        let lastScrollY = window.scrollY;
        let scrollTimer: number | null = null;

        function handleScroll() {
          const currentScrollY = window.scrollY;

          // 1. Auto-hide top header when scrolling down, show when scrolling up
          if (currentScrollY > 90 && currentScrollY > lastScrollY) {
            nav?.classList.add('nav--hidden');
          } else {
            nav?.classList.remove('nav--hidden');
          }

          if (currentScrollY > 60) {
            nav?.classList.add('nav--scrolled');
          } else {
            nav?.classList.remove('nav--scrolled');
          }

          // 2. Glass transparency for bottom dock while scrolling
          bottomDock?.classList.add('dock--scrolling');

          if (scrollTimer !== null) {
            clearTimeout(scrollTimer);
          }

          scrollTimer = window.setTimeout(() => {
            bottomDock?.classList.remove('dock--scrolling');
          }, 350);

          lastScrollY = currentScrollY;
        }

        window.addEventListener('scroll', handleScroll, { passive: true });

        // --- Animated Counters ---
        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const target = parseFloat(el.dataset.target || '0');
              const prefix = el.dataset.prefix || '';
              const suffix = el.dataset.suffix || '';
              const duration = 1500;
              const start = performance.now();

              function animate(now: number) {
                const elapsed = now - start;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
                const current = Math.round(target * eased);
                el.textContent = `${prefix}${current.toLocaleString('en-IN')}${suffix}`;
                if (progress < 1) requestAnimationFrame(animate);
              }

              requestAnimationFrame(animate);
              counterObserver.unobserve(el);
            }
          });
        }, { threshold: 0.5 });

        document.querySelectorAll('[data-counter]').forEach((el) => {
          counterObserver.observe(el);
        });
      }

      // Re-initialize scripts on Astro View Transitions
      document.addEventListener('astro:page-load', initPage);
      initPage();
    </script>
  </body>
</html>

<style is:global>
  /* ===== Nav ===== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding: var(--space-xs) 0;
    background: rgba(255, 248, 240, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(26, 26, 46, 0.08);
    box-shadow: 0 4px 20px rgba(26, 26, 46, 0.05);
    transition: transform 300ms var(--ease-out), background var(--transition-base), box-shadow var(--transition-base), padding var(--transition-base);
  }

  .nav.nav--hidden {
    transform: translateY(-100%);
  }

  .nav--scrolled {
    background: rgba(255, 248, 240, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 6px 24px rgba(26, 26, 46, 0.08);
    padding: 0;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav__logo-img {
    height: clamp(100px, 24vw, 140px);
    width: auto;
    max-width: clamp(210px, 60vw, 320px);
    object-fit: contain;
    margin-top: -18px;
    margin-bottom: -18px;
    margin-left: -4px;
    filter: 
      drop-shadow(1.5px 0 0 #ffffff)
      drop-shadow(-1.5px 0 0 #ffffff)
      drop-shadow(0 1.5px 0 #ffffff)
      drop-shadow(0 -1.5px 0 #ffffff)
      drop-shadow(1px 1px 0 #ffffff)
      drop-shadow(-1px -1px 0 #ffffff)
      drop-shadow(1px -1px 0 #ffffff)
      drop-shadow(-1px 1px 0 #ffffff)
      drop-shadow(0 4px 10px rgba(0,0,0,0.12));
    transition: transform var(--transition-fast), filter var(--transition-fast);
  }

  @media (max-width: 767px) {
    .nav__inner {
      justify-content: center;
    }

    .nav__logo {
      margin: 0 auto;
    }

    .nav__logo-img {
      height: 110px;
      max-width: 240px;
      margin-left: auto;
      margin-right: auto;
      margin-top: -12px;
      margin-bottom: -12px;
    }
  }

  .nav__logo:hover .nav__logo-img {
    transform: rotate(-3deg) scale(1.05);
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }

  /* ===== Sticker Icon Only Nav Items ===== */
  .nav__item-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-sticker-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #1a1a2e;
    box-shadow: 0 3px 6px rgba(26, 26, 46, 0.12);
    font-size: 0.95rem;
    line-height: 1;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .nav__item-link:hover .nav-sticker-icon,
  .nav__item-link.is-active .nav-sticker-icon {
    transform: scale(1.15) rotate(-6deg);
    box-shadow: 0 6px 14px rgba(26, 26, 46, 0.18);
    border-color: var(--icon-accent, var(--accent-coral));
  }

  .nav__item-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .nav__item-link:hover .nav__item-text,
  .nav__item-link.is-active .nav__item-text {
    color: var(--accent-coral);
  }

  /* ===== Option 3: App-Style Floating Mobile Bottom Dock ===== */
  .mobile-bottom-dock {
    display: flex;
    align-items: center;
    justify-content: space-around;
    position: fixed;
    bottom: clamp(12px, 3.5vw, 20px);
    left: 50%;
    transform: translateX(-50%);
    width: min(440px, 92vw);
    padding: 8px 10px;
    background: rgba(255, 248, 240, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 2px solid rgba(26, 26, 46, 0.18);
    border-radius: var(--radius-full);
    box-shadow: 0 12px 35px rgba(26, 26, 46, 0.18);
    z-index: var(--z-nav);
    transition: background 300ms var(--ease-out), opacity 300ms var(--ease-out), box-shadow 300ms var(--ease-out), border-color 300ms var(--ease-out);
  }

  .mobile-bottom-dock.dock--scrolling {
    background: rgba(255, 248, 240, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: rgba(26, 26, 46, 0.1);
    box-shadow: 0 4px 15px rgba(26, 26, 46, 0.08);
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .mobile-bottom-dock {
      display: none;
    }
  }

  .mobile-dock-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-decoration: none;
    padding: 4px 6px;
    border-radius: var(--radius-md);
    transition: transform var(--transition-fast);
  }

  .dock-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #1a1a2e;
    box-shadow: 0 2px 5px rgba(26, 26, 46, 0.1);
    font-size: 0.9rem;
    line-height: 1;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .dock-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .mobile-dock-link.is-active .dock-icon {
    transform: translateY(-4px) scale(1.15);
    border-color: var(--dock-accent, var(--accent-coral));
    box-shadow: 0 6px 14px rgba(26, 26, 46, 0.22);
  }

  .mobile-dock-link.is-active .dock-label {
    color: var(--text-primary);
    font-weight: 900;
  }

  /* ===== Footer ===== */
  .footer {
    background: var(--bg-cream-dark);
    padding-block: var(--space-3xl);
    padding-bottom: calc(var(--space-3xl) + 60px); /* Leave room for mobile bottom dock */
    margin-top: var(--space-4xl);
    border-top: 1px solid var(--bg-cream-darker);
  }

  @media (min-width: 768px) {
    .footer {
      padding-bottom: var(--space-3xl);
    }
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 0;
  }

  .footer__links {
    display: flex;
    gap: var(--space-lg);
  }

  .footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .footer__social:hover {
    background: var(--text-primary);
    color: var(--bg-cream);
    transform: translateY(-2px);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--text-light);
    margin-bottom: 0;
  }
</style>
